# Frontend prototype / AI
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
VITE_PETOS_API_BASE_URL="http://localhost:3001"

# Pet OS production API
NODE_ENV="development"
API_PORT="3001"
DATABASE_URL="postgresql://petos:change-me@localhost:5432/petos"
DATABASE_RUNTIME_ROLE="petos_app"
REDIS_URL="redis://localhost:6379"
CORS_ORIGINS="http://localhost:3000"
AUTH_ISSUER="https://auth.example.com"
AUTH_AUDIENCE="pet-os-api"

# Configure exactly one verifier in a real environment:
AUTH_JWT_SECRET=""
AUTH_JWKS_URL=""

RATE_LIMIT_PER_MINUTE="120"
BILLING_ADAPTER_SECRET="replace-with-at-least-32-bytes"
LOCATION_ADAPTER_SECRET="replace-with-at-least-32-bytes"

# Docker Compose production topology
POSTGRES_PASSWORD="change-me"
