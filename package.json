{
  "name": "pet-os",
  "private": true,
  "version": "0.42.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0",
    "test": "tsx scripts/run-all-tests.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run certification:check && npm run production-readiness:check && npm run server:build && npm run build && npm run performance:check",
    "clean": "rm -rf dist server.js",
    "performance:check": "tsx scripts/check-performance-budget.ts",
    "certification:check": "tsx scripts/run-certification.ts",
    "production-readiness:check": "tsx scripts/run-production-readiness.ts",
    "server:dev": "tsx server/index.ts",
    "server:build": "esbuild server/index.ts server/migrate.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server",
    "server:start": "node dist-server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "backend:integration": "tsx server/tests/integration.ts",
    "backend:wave2-integration": "tsx server/tests/wave2-integration.ts",
    "backend:wave3-integration": "tsx server/tests/wave3-integration.ts",
    "backend:wave4-integration": "tsx server/tests/wave4-integration.ts",
    "backend:wave5-integration": "tsx server/tests/wave5-integration.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "redis": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.15.5"
  },
  "engines": {
    "node": ">=20"
  }
}
